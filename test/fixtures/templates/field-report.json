  "header": {
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Field report, page "
          },
          {
            "type": "variable",
            "attrs": {
              "key": "page.current"
            }
          }
        ]
      }
    ],
    "height": "12mm",
    "spacingToContent": "6mm",
    "inherit": false
  },
  "footer": {
    "content": [
      {
        "type": "paragraph",
        "content": [
          {
            "type": "variable",
            "attrs": {
              "key": "page.current"
            }
          },
          {
            "type": "text",
            "text": " of "
          },
          {
            "type": "variable",
            "attrs": {
              "key": "page.total"
            }
          }
        ]
      }
    ],
    "height": "10mm",
    "spacingToContent": "4mm"
  },
  "footnotes": {
    "numbering": "document",
    "suffix": ".",
    "separator": {
      "enabled": true,
      "thickness": "0.5pt",
      "color": "#64748b"
    },
    "spacingToContent": "10pt",
    "entrySpacing": "4pt",
    "marker": {
      "font": "Georgia",
      "size": "8pt",
      "weight": 400,
      "italic": true,
      "underline": false,
      "color": "#1f2937"
