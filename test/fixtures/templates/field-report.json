            "spacing": "2pt"
          }
        },
        {
          "indentation": "12pt",
          "spaceBefore": "0pt",
          "spaceAfter": "2pt"
        },
        {
          "indentation": "24pt",
          "spaceBefore": "0pt",
          "spaceAfter": "0pt",
          "leader": {
            "character": "·",
            "spacing": "1pt",
            "gapBefore": "2pt",
            "gapAfter": "4pt"
          }
        }
      ],
      "kinds": {
        "toc": {
          "title": "Contents"
        },
        "figures": {
          "title": "Figures",
          "leader": {
            "character": "_"
          }
        },
        "tables": {
          "title": "Tables",
          "levels": [
            {
              "leader": {
                "character": ""
              }
            }
          ]
        }
      }
