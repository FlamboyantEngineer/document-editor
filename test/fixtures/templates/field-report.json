        "right": "0pt",
        "bottom": "6pt",
        "left": "0pt"
      },
      "spacing": {
        "top": "6pt",
        "right": "0pt",
        "bottom": "12pt",
        "left": "0pt"
      },
      "leader": {
        "character": ".",
        "spacing": "2pt",
        "gapBefore": "3pt",
        "gapAfter": "3pt"
      },
      "levels": [
        {
          "indentation": "0pt",
          "spaceBefore": "6pt",
          "spaceAfter": "2pt",
          "leader": {
