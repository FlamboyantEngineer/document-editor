  },
  "references": {
    "formats": {
      "internal-figure": "Figure {{ref.numbering}}",
      "internal-table": "Table {{ref.numbering}}"
    },
    "links": {
      "internal-figure": true,
      "internal-table": false
    }
  },
  "changeBars": {
