  "sections": [
    {
      "name": "body",
      "content": [
        {
          "type": "heading",
          "attrs": {
            "id": "5dacab09"
          },
          "content": [
            {
              "type": "text",
              "text": "Paragraph levels"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "style": "lead",
            "id": "5aaca650"
          },
          "content": [
            {
              "type": "text",
              "text": "Paths between the beds are wide enough for a wheelbarrow to pass. The bench by the pond is a good place to sort seed packets."
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "5baca7e3"
          },
          "content": [
            {
              "type": "text",
              "text": "Level 1. Each season ends with a shared meal and a swap of saved seeds. The lighthouse lamp turns once every twelve seconds."
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "60acafc2",
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Level 2. Keepers logged the wind direction at the top of every hour. A brass barometer hangs beside the stairs to the lantern room."
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "61acb155",
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "Level 3. Fog signals sounded in groups of two when visibility dropped. The station records temperature, pressure and humidity each minute."
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "5eacac9c",
            "level": 4
          },
          "content": [
            {
              "type": "text",
              "text": "Level 4. Readings older than a year move to the archive drive. A bicycle chain needs a drop of oil on every link, then a wipe."
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "5facae2f",
            "level": 5
          },
          "content": [
            {
              "type": "text",
              "text": "Level 5. Brake pads wear faster in wet weather and on long descents. The reading room opens at nine and closes at six on weekdays."
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "64acb60e",
            "level": 6
          },
          "content": [
            {
              "type": "text",
              "text": "Level 6. Maps larger than the tables are kept flat in the plan chest. The north bed holds the early beans and two rows of lettuce."
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "style": "note",
            "id": "65acb7a1"
          },
          "content": [
            {
              "type": "text",
              "text": "Water reaches each plot through a drip line laid under the mulch."
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "style": "note",
            "id": "afd18abb",
            "level": 3
          },
          "content": [
            {
              "type": "text",
              "text": "A note at level three."
            }
          ]
        }
      ]
    }
  ]
}
