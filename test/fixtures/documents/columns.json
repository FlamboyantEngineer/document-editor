              ]
            }
          ]
        },
        {
          "type": "columns",
          "attrs": {
            "preset": "third-two-thirds",
            "id": "789337f6"
          },
          "content": [
            {
              "type": "column",
              "attrs": {
                "id": "7f99fec0"
              },
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "id": "809a0053"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Narrow"
                    }
                  ]
                }
              ]
            },
            {
              "type": "column",
              "attrs": {
                "id": "77933663"
              },
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "id": "769334d0"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Readings older than a year move to the archive drive. A bicycle chain needs a drop of oil on every link, then a wipe. Brake pads wear faster in wet weather and on long descents. The reading room opens at nine and closes at six on weekdays. Maps larger than the tables are kept flat in the plan chest."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "columns",
          "attrs": {
            "preset": "two-thirds-third",
            "id": "7d933fd5"
          },
          "content": [
            {
              "type": "column",
              "attrs": {
                "id": "7a933b1c"
              },
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "id": "79933989"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "The north bed holds the early beans and two rows of lettuce. Water reaches each plot through a drip line laid under the mulch. Volunteers record rainfall every morning before the gate opens. The tool shed keeps spades, forks and a wheelbarrow with a spare tyre. Compost is turned once a week and covered when frost is forecast."
                    }
                  ]
                }
              ]
            },
            {
              "type": "column",
              "attrs": {
                "id": "7c933e42"
              },
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "id": "7b933caf"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Narrow"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "columns",
          "attrs": {
            "preset": "single",
            "id": "7c957cd9"
          },
          "content": [
            {
              "type": "column",
              "attrs": {
                "id": "7f9342fb"
              },
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "id": "7e934168"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "A rain barrel at each corner collects water from the shelter roof. Seedlings start in the cold frame and move out after the last frost."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
