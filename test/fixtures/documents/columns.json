      "name": "body",
      "content": [
        {
          "type": "heading",
          "attrs": {
            "id": "26e83e79"
          },
          "content": [
            {
              "type": "text",
              "text": "Column layouts"
            }
          ]
        },
        {
          "type": "columns",
          "attrs": {
            "id": "27e8400c"
          },
          "content": [
            {
              "type": "column",
              "attrs": {
                "id": "24e83b53"
              },
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "id": "23e839c0"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Paths between the beds are wide enough for a wheelbarrow to pass. The bench by the pond is a good place to sort seed packets. Each season ends with a shared meal and a swap of saved seeds."
                    }
                  ]
                }
              ]
            },
            {
              "type": "column",
              "attrs": {
                "id": "2ae844c5"
              },
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "id": "29e84332"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "The lighthouse lamp turns once every twelve seconds. Keepers logged the wind direction at the top of every hour. A brass barometer hangs beside the stairs to the lantern room."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "columns",
          "attrs": {
            "preset": "thirds",
            "id": "8d9a14ca"
          },
          "content": [
            {
              "type": "column",
              "attrs": {
                "id": "2de8497e"
              },
              "content": [
                {
                  "type": "paragraph",
                  "attrs": {
                    "id": "28e8419f"
                  },
                  "content": [
                    {
                      "type": "text",
                      "text": "Fog signals sounded in groups of two when visibility dropped. The station records temperature, pressure and humidity each minute."
                    }
                  ]
                }
              ]
            },
            {
              "type": "column",
              "attrs": {
                "id": "8c9a1337"
              },
              "content": [
                {
                  "type": "bulletList",
