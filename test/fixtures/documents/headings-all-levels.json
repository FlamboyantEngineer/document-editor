  "formatVersion": 1,
  "template": "regression-base",
  "sections": [
    {
      "name": "body",
      "content": [
        {
          "type": "heading",
          "attrs": {
            "title": true,
            "id": "285c53ad"
          },
          "content": [
            {
              "type": "text",
              "text": "Garden handbook"
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "id": "255c4ef4"
          },
          "content": [
            {
              "type": "text",
              "text": "Heading at level 1"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "265c5087"
          },
          "content": [
            {
              "type": "text",
              "text": "Maps larger than the tables are kept flat in the plan chest. The north bed holds the early beans and two rows of lettuce."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "235c4bce"
          },
          "content": [
            {
              "type": "text",
              "text": "Heading at level 2"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "245c4d61"
          },
          "content": [
            {
              "type": "text",
              "text": "Water reaches each plot through a drip line laid under the mulch. Volunteers record rainfall every morning before the gate opens."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 3,
            "id": "215c48a8"
          },
          "content": [
            {
              "type": "text",
              "text": "Heading at level 3"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "225c4a3b"
          },
          "content": [
            {
              "type": "text",
              "text": "The tool shed keeps spades, forks and a wheelbarrow with a spare tyre. Compost is turned once a week and covered when frost is forecast."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 4,
            "id": "1f5c4582"
          },
          "content": [
            {
              "type": "text",
              "text": "Heading at level 4"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "205c4715"
          },
          "content": [
            {
              "type": "text",
              "text": "A rain barrel at each corner collects water from the shelter roof. Seedlings start in the cold frame and move out after the last frost."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 5,
            "id": "2657a027"
          },
          "content": [
            {
              "type": "text",
              "text": "Heading at level 5"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "25579e94"
          },
          "content": [
            {
              "type": "text",
              "text": "Paths between the beds are wide enough for a wheelbarrow to pass. The bench by the pond is a good place to sort seed packets."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 6,
            "id": "2857a34d"
          },
          "content": [
            {
              "type": "text",
              "text": "Heading at level 6"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "2757a1ba"
          },
          "content": [
            {
              "type": "text",
              "text": "Each season ends with a shared meal and a swap of saved seeds. The lighthouse lamp turns once every twelve seconds."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "id": "225799db"
          },
          "content": [
            {
              "type": "text",
              "text": "Second chapter"
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "21579848"
          },
          "content": [
            {
              "type": "text",
              "text": "Back to level two"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "24579d01"
          },
          "content": [
            {
              "type": "text",
              "text": "Keepers logged the wind direction at the top of every hour. A brass barometer hangs beside the stairs to the lantern room."
            }
          ]
        }
      ]
    }
  ]
}
