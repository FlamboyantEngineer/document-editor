        {
          "type": "paragraph",
          "attrs": {
            "id": "322eff88"
          },
          "content": [
            {
              "type": "text",
              "text": "The bench by the pond is a good place to sort seed packets. Each season ends with a shared meal and a swap of saved seeds."
            }
          ]
        },
