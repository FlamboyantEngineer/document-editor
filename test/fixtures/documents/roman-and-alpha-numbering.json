              "type": "text",
              "text": "Preface"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "392f0a8d"
          },
          "content": [
            {
              "type": "text",
              "text": "A rain barrel at each corner collects water from the shelter roof. Seedlings start in the cold frame and move out after the last frost. Paths between the beds are wide enough for a wheelbarrow to pass."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "id": "382f08fa"
          },
          "content": [
