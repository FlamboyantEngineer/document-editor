              "text": "Front 47"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "73c36da2"
          },
          "content": [
            {
              "type": "text",
              "text": "The bench by the pond is a good place to sort seed packets."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "74c36f35"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 48"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "71c36a7c"
          },
          "content": [
            {
              "type": "text",
              "text": "Each season ends with a shared meal and a swap of saved seeds."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "id": "72c36c0f"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 49"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "77c373ee"
          },
          "content": [
            {
              "type": "text",
              "text": "The lighthouse lamp turns once every twelve seconds."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "78c37581"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 50"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "4d81ae0a"
          },
          "content": [
            {
              "type": "text",
              "text": "Keepers logged the wind direction at the top of every hour."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "4e81af9d"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 51"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "4b81aae4"
          },
          "content": [
            {
              "type": "text",
              "text": "A brass barometer hangs beside the stairs to the lantern room."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "4c81ac77"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 52"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "4981a7be"
          },
          "content": [
            {
              "type": "text",
              "text": "Fog signals sounded in groups of two when visibility dropped."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "id": "4a81a951"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 53"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "4781a498"
          },
          "content": [
            {
              "type": "text",
              "text": "The station records temperature, pressure and humidity each minute."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "4881a62b"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 54"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "4581a172"
          },
          "content": [
            {
              "type": "text",
              "text": "Readings older than a year move to the archive drive."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "4681a305"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 55"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "b3848d33"
          },
          "content": [
            {
              "type": "text",
              "text": "A bicycle chain needs a drop of oil on every link, then a wipe."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "b2848ba0"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 56"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "b5849059"
          },
          "content": [
            {
              "type": "text",
              "text": "Brake pads wear faster in wet weather and on long descents."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "id": "b4848ec6"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 57"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "b784937f"
          },
          "content": [
            {
              "type": "text",
              "text": "The reading room opens at nine and closes at six on weekdays."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "b68491ec"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 58"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "b98496a5"
          },
          "content": [
            {
              "type": "text",
              "text": "Maps larger than the tables are kept flat in the plan chest."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "b8849512"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 59"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "bb8499cb"
          },
          "content": [
            {
              "type": "text",
              "text": "The north bed holds the early beans and two rows of lettuce."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2,
            "id": "ba849838"
          },
          "content": [
            {
              "type": "text",
              "text": "Front 60"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "417d1df8"
          },
          "content": [
            {
              "type": "text",
              "text": "Water reaches each plot through a drip line laid under the mulch."
            }
          ]
        }
      ]
    },
    {
      "name": "body",
      "content": [
        {
          "type": "heading",
          "attrs": {
            "id": "427d1f8b"
          },
          "content": [
            {
              "type": "text",
              "text": "Body"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "437d211e"
          },
          "content": [
            {
              "type": "text",
              "text": "Volunteers record rainfall every morning before the gate opens."
            }
          ]
        }
      ]
    }
  ]
