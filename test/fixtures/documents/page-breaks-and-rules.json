          },
          "content": [
            {
              "type": "text",
              "text": "First page"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "7fa13923"
          },
          "content": [
            {
              "type": "text",
              "text": "Water reaches each plot through a drip line laid under the mulch. Volunteers record rainfall every morning before the gate opens."
            }
          ]
        },
        {
          "type": "pageBreak",
          "attrs": {
            "id": "7ea13790"
          }
        },
        {
          "type": "heading",
          "attrs": {
            "id": "85a14295"
          },
          "content": [
            {
              "type": "text",
              "text": "Second page"
            }
          ]
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "84a14102"
          },
          "content": [
            {
              "type": "text",
              "text": "The tool shed keeps spades, forks and a wheelbarrow with a spare tyre. Compost is turned once a week and covered when frost is forecast."
            }
          ]
        },
        {
          "type": "rule",
          "attrs": {
            "id": "83a13f6f"
          }
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "82a13ddc"
          },
          "content": [
            {
              "type": "text",
              "text": "A rain barrel at each corner collects water from the shelter roof. Seedlings start in the cold frame and move out after the last frost."
            }
          ]
        },
        {
          "type": "pageBreak",
          "attrs": {
            "id": "89a148e1"
          }
        },
        {
          "type": "pageBreak",
          "attrs": {
            "id": "88a1474e"
          }
        },
        {
          "type": "paragraph",
          "attrs": {
            "id": "03cf20f2"
          },
          "content": [
            {
              "type": "text",
              "text": "After two breaks."
            }
          ]
        }
      ]
    }
  ]
}
