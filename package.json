{
  "name": "@flamboyantengineer/document-editor",
  "version": "0.0.0",
  "description": "Paginated, template-driven document editor built on @flamboyantengineer/ui-components, embeddable through host adapters.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlamboyantEngineer/document-editor.git"
  },
  "browserslist": [
    "chrome >= 117",
    "edge >= 117",
    "firefox >= 121",
    "safari >= 17",
    "ios_saf >= 17"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js",
      "default": "./dist/host/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js",
      "default": "./dist/document/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js",
      "default": "./dist/model/index.js"
    },
    "./collab": {
      "types": "./dist/collab/index.d.ts",
      "import": "./dist/collab/index.js",
      "default": "./dist/collab/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "specs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "build:package": "npm run build",
    "prepare": "node scripts/prepare.mjs",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "format": "prettier --write --cache --cache-strategy content .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/dev --passWithNoTests",
    "test:watch": "vitest",
    "check:references": "node scripts/check-references.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "build:labs": "node scripts/build-labs.mjs",
    "serve:labs": "node scripts/serve-labs.mjs",
    "labs": "node scripts/start-labs.mjs",
    "test:labs": "playwright test --project=chromium --project=performance",
    "test:perf": "playwright test --project=budgets --workers=1",
    "check": "node scripts/check.mjs"
  },
  "peerDependencies": {
    "@flamboyantengineer/ui-components": ">=0.1.0",
    "@handlewithcare/react-prosemirror": "^3.2.11",
    "@y/y": "^14.0.0-rc.23",
    "katex": "^0.19.1",
    "lib0": "1.0.0-rc.22",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@flamboyantengineer/collaboration-tools": "git+https://github.com/FlamboyantEngineer/collaboration-tools.git#91721037bb5c8af30914bc9b0da8b5f51ed7162f",
    "@flamboyantengineer/ui-components": "git+https://github.com/FlamboyantEngineer/ui-components.git#4937fed7f96fc1b9224d5f4c30f32e93b27604e5",
    "@handlewithcare/react-prosemirror": "^3.2.11",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@y/y": "14.0.0-rc.23",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "katex": "^0.19.1",
    "lib0": "1.0.0-rc.22",
    "prettier": "^3.9.10",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-reconciler": "^0.33.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.6.0"
  },
  "peerDependenciesMeta": {
    "@y/y": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "lib0": {
      "optional": true
    }
  }
}
