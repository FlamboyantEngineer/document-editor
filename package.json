{
  "name": "@flamboyantengineer/document-editor",
  "version": "0.0.0",
  "description": "Paginated, template-driven document editor built on @flamboyantengineer/ui-components, embeddable through host adapters.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlamboyantEngineer/document-editor.git"
  },
  "browserslist": [
    "chrome >= 117",
    "edge >= 117",
    "firefox >= 121",
    "safari >= 17",
    "ios_saf >= 17"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js",
      "default": "./dist/host/index.js"
    },
    "./document": {
      "types": "./dist/document/index.d.ts",
      "import": "./dist/document/index.js",
      "default": "./dist/document/index.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "import": "./dist/model/index.js",
      "default": "./dist/model/index.js"
    },
    "./collab": {
      "types": "./dist/collab/index.d.ts",
      "import": "./dist/collab/index.js",
      "default": "./dist/collab/index.js"
    },
    "./import": {
      "types": "./dist/import/index.d.ts",
      "import": "./dist/import/index.js",
      "default": "./dist/import/index.js"
    },
    "./package.json": "./package.json",
    "./reference.css": "./reference.css",
    "./shadcn.css": "./shadcn.css"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "specs",
    "CHANGELOG.md",
    "./reference.css",
    "./shadcn.css",
    "labs/reference/document.css",
    "labs/reference/editor-chrome.css",
    "labs/shadcn/editor-chrome.css",
    "!labs/reference.css",
    "!labs/shadcn.css"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "build:package": "npm run build",
    "prepare": "node scripts/prepare.mjs",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "format": "prettier --write --cache --cache-strategy content .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:changed": "node scripts/test-changed.mjs",
    "test:watch": "vitest",
    "check:references": "ui-components-tooling check-references",
    "check:specs": "ui-components-tooling check-specs",
    "check:exports": "ui-components-tooling check-exports",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "build:labs": "node scripts/build-labs.mjs",
    "serve:labs": "node scripts/serve-labs.mjs",
    "labs": "node scripts/start-labs.mjs",
    "test:labs": "playwright test --project=chromium --project=chromium-invariant --project=chromium-dpr-1.25 --project=chromium-dpr-2 --project=chromium-dpr-1.5 --project=chromium-dpr-1.75 --project=chromium-dpr-3 --project=performance",
    "test:perf": "playwright test --project=budgets --workers=1",
    "check": "node scripts/check.mjs",
    "test:guard-budgets": "vitest run --config vitest.guard.config.ts"
  },
  "peerDependencies": {
    "@flamboyantengineer/ui-components": "git+https://github.com/FlamboyantEngineer/ui-components.git#9bd22af04e5f8ef4384da57715583d9c809e2d02",
    "@handlewithcare/react-prosemirror": "^3.3.0",
    "@y/y": "14.0.0-rc.23",
    "katex": "^0.19.1",
    "lib0": "1.0.0-rc.22",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "1.42.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@flamboyantengineer/collaboration-tools": "git+https://github.com/FlamboyantEngineer/collaboration-tools.git#e712b0cf43105dfe7617b0fbb4da2e5f19bd18b8",
    "@flamboyantengineer/ui-components": "git+https://github.com/FlamboyantEngineer/ui-components.git#9bd22af04e5f8ef4384da57715583d9c809e2d02",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/cousine": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/tinos": "^5.3.0",
    "@handlewithcare/react-prosemirror": "3.3.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@y/y": "14.0.0-rc.23",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-jest-dom": "^5.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "harfbuzzjs": "^1.6.4",
    "jsdom": "^31.0.1",
    "katex": "^0.19.1",
    "lib0": "1.0.0-rc.22",
    "prettier": "^3.10.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.2",
    "prosemirror-inputrules": "^1.7.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.7",
    "prosemirror-view": "1.42.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-reconciler": "^0.33.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "webpack": "^5.112.2"
  },
  "dependencies": {
    "@chenglou/pretext": "github:FlamboyantEngineer/pretext#8be6407a4f81c6e170530c00c9d7e8353d358a6a",
    "@mathjax/mathjax-stix2-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "fflate": "^0.8.3",
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.6.1"
  },
  "peerDependenciesMeta": {
    "@y/y": {
      "optional": true
    },
    "katex": {
      "optional": true
    },
    "lib0": {
      "optional": true
    }
  }
}
