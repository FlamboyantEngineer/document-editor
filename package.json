{
  "name": "@flamboyantengineer/document-editor",
  "version": "0.0.0",
  "description": "Paginated, template-driven document editor built on @flamboyantengineer/ui-components, embeddable through host adapters.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlamboyantEngineer/document-editor.git"
  },
  "browserslist": [
    "chrome >= 117",
    "edge >= 117",
    "firefox >= 121",
    "safari >= 17",
    "ios_saf >= 17"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js",
      "default": "./dist/host/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "src",
    "!src/**/*.test.*",
    "specs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs dist && tsc -p tsconfig.build.json",
    "build:package": "npm run build",
    "prepare": "node scripts/prepare.mjs",
    "lint": "node --max-old-space-size=6144 node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "format": "prettier --write --cache --cache-strategy content .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/dev --passWithNoTests",
    "test:watch": "vitest",
    "check:references": "node scripts/check-references.mjs",
    "check:specs": "node scripts/check-specs.mjs",
    "check": "node scripts/check.mjs"
  },
  "peerDependencies": {
    "@flamboyantengineer/ui-components": ">=0.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@flamboyantengineer/ui-components": "git+https://github.com/FlamboyantEngineer/ui-components.git#422920ac4f1a4050e19d3ec61eb4e58777ef3cb0",
    "eslint": "^10.13.0",
    "eslint-plugin-jest-dom": "^5.10.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
